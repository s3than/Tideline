---
import '../styles/global.css';
import { getLibraries } from '../lib/db';
import Search from '../components/Search.astro';

interface Props {
  title?: string;
  bare?: boolean;
}
const { title = 'Tideline', bare = false } = Astro.props;
const user = Astro.locals.user;
const pathname = Astro.url.pathname;
const avatarUrl = user?.primaryImageTag
  ? `/api/image/user/${user.jellyfinId}?tag=${user.primaryImageTag}`
  : null;
const menuLibraries = user ? getLibraries().filter((l) => l.viewInMenu) : [];
---

<!doctype html>
<html lang="en" class="bg-[#0d0d1a] text-white h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex h-screen overflow-hidden font-sans antialiased">
    {
      bare ? (
        <main class="flex flex-1 items-center justify-center overflow-y-auto">
          <slot />
        </main>
      ) : (
        <>
          {/* Mobile backdrop */}
          <div
            id="sidebar-backdrop"
            class="fixed inset-0 z-20 bg-black/60 hidden"
            aria-hidden="true"
          />

          {/* Sidebar */}
          <aside
            id="sidebar"
            class="fixed inset-y-0 left-0 z-30 flex w-56 flex-col border-r border-white/10 bg-[#111128] transition-[width,transform] duration-300 -translate-x-full md:relative md:translate-x-0 md:flex-shrink-0"
          >
            {/* Logo */}
            <div class="flex h-16 flex-shrink-0 items-center gap-3 border-b border-white/10 px-4 overflow-hidden">
              <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-accent">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-4 w-4"
                >
                  <path d="M3.375 3C2.339 3 1.5 3.84 1.5 4.875v.75c0 1.036.84 1.875 1.875 1.875h17.25c1.035 0 1.875-.84 1.875-1.875v-.75C22.5 3.839 21.66 3 20.625 3H3.375Z" />
                  <path
                    fill-rule="evenodd"
                    d="m3.087 9 .54 9.176A3 3 0 0 0 6.62 21h10.757a3 3 0 0 0 2.995-2.824L20.913 9H3.087Zm6.163 3.75A.75.75 0 0 1 10 12h4a.75.75 0 0 1 0 1.5h-4a.75.75 0 0 1-.75-.75Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </div>
              <span class="sidebar-label text-base font-semibold tracking-tight whitespace-nowrap">
                Tideline
              </span>
            </div>

            {/* Nav links */}
            <nav class="flex-1 overflow-y-auto px-2 py-4 space-y-1">
              <a
                href="/"
                class:list={[
                  'nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
                  pathname === '/'
                    ? 'bg-white/10 text-white hover:bg-white/15'
                    : 'text-white/60 hover:bg-white/10 hover:text-white',
                ]}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-5 w-5 flex-shrink-0"
                >
                  <path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z" />
                  <path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z" />
                </svg>
                <span class="sidebar-label">Discover</span>
              </a>
              {menuLibraries.map((lib) => (
                <a
                  href={`/library/${lib.slug}`}
                  class:list={[
                    'nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
                    pathname === `/library/${lib.slug}`
                      ? 'bg-white/10 text-white hover:bg-white/15'
                      : 'text-white/60 hover:bg-white/10 hover:text-white',
                  ]}
                >
                  {lib.itemType === 'Movie' ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-5 w-5 flex-shrink-0"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M1.5 5.625c0-1.036.84-1.875 1.875-1.875h17.25c1.035 0 1.875.84 1.875 1.875v12.75c0 1.035-.84 1.875-1.875 1.875H3.375A1.875 1.875 0 0 1 1.5 18.375V5.625ZM21 9.375A.375.375 0 0 0 20.625 9h-7.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h7.5A.375.375 0 0 0 21 10.875v-1.5Zm0 3.75a.375.375 0 0 0-.375-.375h-7.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h7.5a.375.375 0 0 0 .375-.375v-1.5Zm0 3.75a.375.375 0 0 0-.375-.375h-7.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h7.5a.375.375 0 0 0 .375-.375v-1.5ZM10.875 18.75a.375.375 0 0 0 .375-.375v-1.5a.375.375 0 0 0-.375-.375h-7.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h7.5ZM3.375 15h7.5a.375.375 0 0 0 .375-.375v-1.5a.375.375 0 0 0-.375-.375h-7.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375Zm0-3.75h7.5a.375.375 0 0 0 .375-.375v-1.5A.375.375 0 0 0 10.875 9h-7.5A.375.375 0 0 0 3 9.375v1.5c0 .207.168.375.375.375Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  ) : lib.itemType === 'Collection' ? (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-5 w-5 flex-shrink-0"
                    >
                      <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.146V6a3 3 0 0 1 3-3h5.379a2.25 2.25 0 0 1 1.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 0 1 3 3v1.146A4.483 4.483 0 0 0 19.5 9h-15a4.483 4.483 0 0 0-3 1.146Z" />
                    </svg>
                  ) : (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-5 w-5 flex-shrink-0"
                    >
                      <path d="M19.5 6h-15v9h15V6Z" />
                      <path
                        fill-rule="evenodd"
                        d="M3.375 3C2.339 3 1.5 3.84 1.5 4.875v11.25C1.5 17.16 2.34 18 3.375 18H9.75v1.5H6A.75.75 0 0 0 6 21h12a.75.75 0 0 0 0-1.5h-3.75V18h6.375c1.035 0 1.875-.84 1.875-1.875V4.875C22.5 3.839 21.66 3 20.625 3H3.375Zm0 13.5h17.25a.375.375 0 0 0 .375-.375V4.875a.375.375 0 0 0-.375-.375H3.375A.375.375 0 0 0 3 4.875v11.25c0 .207.168.375.375.375Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  )}
                  <span class="sidebar-label">{lib.label}</span>
                </a>
              ))}

              {user?.isAdministrator && (
                <a
                  href="/admin"
                  class:list={[
                    'nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
                    pathname.startsWith('/admin')
                      ? 'bg-white/10 text-white hover:bg-white/15'
                      : 'text-white/60 hover:bg-white/10 hover:text-white',
                  ]}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5 flex-shrink-0"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M11.078 2.25c-.917 0-1.699.663-1.85 1.567L9.05 4.889c-.02.12-.115.26-.297.348a7.493 7.493 0 0 0-.986.57c-.166.115-.334.126-.45.083L6.3 5.508a1.875 1.875 0 0 0-2.282.819l-.922 1.597a1.875 1.875 0 0 0 .432 2.385l.84.692c.095.078.17.229.154.43a7.598 7.598 0 0 0 0 1.139c.015.2-.059.352-.153.43l-.841.692a1.875 1.875 0 0 0-.432 2.385l.922 1.597a1.875 1.875 0 0 0 2.282.818l1.019-.382c.115-.043.283-.031.45.082.312.214.641.405.985.57.182.088.277.228.297.35l.178 1.071c.151.904.933 1.567 1.85 1.567h1.844c.916 0 1.699-.663 1.85-1.567l.178-1.072c.02-.12.114-.26.297-.349.344-.165.673-.356.985-.57.167-.114.335-.125.45-.082l1.02.382a1.875 1.875 0 0 0 2.28-.819l.923-1.597a1.875 1.875 0 0 0-.432-2.385l-.84-.692c-.095-.078-.17-.229-.154-.43a7.614 7.614 0 0 0 0-1.139c-.016-.2.059-.352.153-.43l.84-.692c.708-.582.891-1.59.433-2.385l-.922-1.597a1.875 1.875 0 0 0-2.282-.818l-1.02.382c-.114.043-.282.031-.449-.083a7.49 7.49 0 0 0-.985-.57c-.183-.087-.277-.227-.297-.348l-.179-1.072a1.875 1.875 0 0 0-1.85-1.567h-1.843ZM12 15.75a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span class="sidebar-label">Admin</span>
                </a>
              )}
            </nav>

            {/* Collapse toggle (desktop only) */}
            <button
              id="sidebar-collapse"
              class="hidden md:flex items-center justify-center gap-2 border-t border-white/10 px-4 py-3 text-white/40 transition-colors hover:text-white/70"
              aria-label="Toggle sidebar"
            >
              <svg
                id="collapse-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-4 w-4 transition-transform duration-300"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span class="sidebar-label text-xs">Collapse</span>
            </button>
          </aside>

          {/* Content area */}
          <div class="flex min-w-0 flex-1 flex-col overflow-hidden">
            {/* Header */}
            <header class="flex h-16 flex-shrink-0 items-center gap-3 border-b border-white/10 px-4">
              {/* Mobile hamburger */}
              <button
                id="sidebar-toggle"
                class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg text-white/60 transition-colors hover:bg-white/10 hover:text-white md:hidden"
                aria-label="Open menu"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-5 w-5"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </button>

              {/* Search */}
              <Search />

              {/* User menu */}
              <div class="relative flex-shrink-0">
                <button
                  id="user-menu-btn"
                  class="flex items-center gap-2 rounded-full transition-colors hover:bg-white/10 px-1 py-1"
                  aria-label="User menu"
                >
                  {avatarUrl ? (
                    <img
                      src={avatarUrl}
                      alt={user?.name ?? 'User'}
                      class="h-8 w-8 rounded-full object-cover ring-2 ring-white/10"
                    />
                  ) : (
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white/60">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="h-5 w-5"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                  )}
                  {user && (
                    <span class="hidden sm:block text-sm font-medium text-white/80 pr-1">
                      {user.name}
                      {user.isAdministrator && (
                        <span class="ml-1.5 rounded px-1 py-0.5 text-[10px] font-semibold uppercase tracking-wide bg-accent/20 text-accent">
                          Admin
                        </span>
                      )}
                    </span>
                  )}
                </button>
                <div
                  id="user-menu"
                  class="absolute right-0 top-full z-50 mt-2 hidden w-48 overflow-hidden rounded-xl border border-white/10 bg-[#1a1a2e] py-1 shadow-2xl"
                >
                  {user && (
                    <div class="border-b border-white/10 px-4 py-3">
                      <p class="text-sm font-medium text-white">{user.name}</p>
                      {user.isAdministrator && <p class="text-xs text-accent">Administrator</p>}
                    </div>
                  )}
                  <button
                    id="logout-btn"
                    class="flex w-full items-center gap-2 px-4 py-2.5 text-sm text-white/70 transition-colors hover:bg-white/5 hover:text-white"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                    >
                      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                      <polyline points="16 17 21 12 16 7" />
                      <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    Sign out
                  </button>
                </div>
              </div>
            </header>

            {/* Page content */}
            <main class="flex-1 overflow-y-auto px-6 py-10 space-y-16">
              <slot />
            </main>

            <footer class="flex-shrink-0 border-t border-white/10 px-6 py-4 text-center text-sm text-white/30">
              Powered by Jellyfin
            </footer>
          </div>
        </>
      )
    }
    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        window.location.href = '/login';
      });

      const userBtn = document.getElementById('user-menu-btn');
      const userMenu = document.getElementById('user-menu');
      userBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        userMenu?.classList.toggle('hidden');
      });
      document.addEventListener('click', () => userMenu?.classList.add('hidden'));

      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const toggleBtn = document.getElementById('sidebar-toggle');

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        backdrop?.classList.remove('hidden');
      }
      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
      }

      toggleBtn?.addEventListener('click', openSidebar);
      backdrop?.addEventListener('click', closeSidebar);

      const collapseBtn = document.getElementById('sidebar-collapse');
      const collapseIcon = document.getElementById('collapse-icon');
      let collapsed = false;

      collapseBtn?.addEventListener('click', () => {
        collapsed = !collapsed;
        if (collapsed) {
          sidebar?.classList.remove('w-56');
          sidebar?.classList.add('w-16');
          collapseIcon?.classList.add('rotate-180');
          sidebar?.querySelectorAll('.sidebar-label').forEach((el) => el.classList.add('hidden'));
          sidebar
            ?.querySelectorAll('.nav-link')
            .forEach((el) => el.classList.add('justify-center'));
        } else {
          sidebar?.classList.remove('w-16');
          sidebar?.classList.add('w-56');
          collapseIcon?.classList.remove('rotate-180');
          sidebar
            ?.querySelectorAll('.sidebar-label')
            .forEach((el) => el.classList.remove('hidden'));
          sidebar
            ?.querySelectorAll('.nav-link')
            .forEach((el) => el.classList.remove('justify-center'));
        }
      });
    </script>
  </body>
</html>
