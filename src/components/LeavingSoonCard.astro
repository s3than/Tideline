---
import type { JellyfinItem } from '../lib/jellyfin';
import { posterUrl, itemTypeLabel, itemDays } from '../lib/jellyfin';
import { leavingBadgeClass, leavingTextClass } from '../lib/format';

interface Props {
  item: JellyfinItem;
  seasons?: JellyfinItem[]; // provided for grouped season entries
  keepId?: string; // item to attach a keep request to (series id for grouped cards)
  keepActive?: boolean; // current user already requested this
}

const { item, seasons, keepId, keepActive } = Astro.props;
const isGroup = !!seasons?.length;

const title = isGroup ? (item.SeriesName ?? item.Name) : itemTypeLabel(item);
const poster = posterUrl(item, 300);
const mediaUrl = isGroup && item.SeriesId ? `/media/${item.SeriesId}` : `/media/${item.Id}`;
const overview = item.Overview?.trim() || null;

const days = isGroup ? Math.min(...seasons!.map((s) => itemDays(s))) : itemDays(item);

const badgeClass = leavingBadgeClass(days);
const daysLabel = days === 1 ? '1 day left' : `${days} days left`;
---

<a
  href={mediaUrl}
  class="group flex flex-col overflow-hidden rounded-lg border border-white/5 bg-white/5 transition-colors hover:border-white/20 hover:bg-white/10"
>
  <div class="relative aspect-2/3 w-full overflow-hidden bg-white/5">
    {
      poster ? (
        <img
          src={poster}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-white/20">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-8 w-8"
          >
            <path d="M12 9a3.75 3.75 0 1 0 0 7.5A3.75 3.75 0 0 0 12 9Z" />
            <path
              fill-rule="evenodd"
              d="M9.344 3.071a49.52 49.52 0 0 1 5.312 0c.967.052 1.83.585 2.332 1.39l.821 1.317c.24.383.645.643 1.11.71.386.054.77.113 1.152.177 1.432.239 2.429 1.493 2.429 2.909V18a3 3 0 0 1-3 3h-15a3 3 0 0 1-3-3V9.574c0-1.416.997-2.67 2.429-2.909.382-.064.766-.123 1.151-.178a1.56 1.56 0 0 0 1.11-.71l.822-1.315a2.942 2.942 0 0 1 2.332-1.39ZM6.75 12.75a5.25 5.25 0 1 1 10.5 0 5.25 5.25 0 0 1-10.5 0Zm12-1.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z"
              clip-rule="evenodd"
            />
          </svg>
        </div>
      )
    }

    <!-- Hover overlay — overview pinned to bottom, badge sits above via z-index -->
    <div
      class="absolute inset-0 flex flex-col justify-end bg-black/85 p-3 opacity-0 transition-opacity duration-200 group-hover:opacity-100"
    >
      {
        isGroup ? (
          <div class="space-y-1.5">
            {overview && (
              <p class="line-clamp-3 text-xs leading-relaxed text-white/80">{overview}</p>
            )}
            <div class="space-y-1">
              {seasons!.map((s) => {
                const d = itemDays(s);
                const seasonLabel = s.IndexNumber != null ? `Season ${s.IndexNumber}` : s.Name;
                return (
                  <div class="flex items-center justify-between gap-2 text-xs">
                    <span class="text-white/70">{seasonLabel}</span>
                    <span class={`font-semibold ${leavingTextClass(d)}`}>{d}d left</span>
                  </div>
                );
              })}
              <p class="text-[10px] text-white/35">✦ other seasons remain</p>
            </div>
          </div>
        ) : (
          overview && <p class="line-clamp-8 text-xs leading-relaxed text-white/80">{overview}</p>
        )
      }
    </div>

    <!-- Badge sits above overlay via z-index -->
    <span
      class={`absolute top-2 right-2 z-10 rounded-full px-2 py-0.5 text-xs font-semibold ${badgeClass}`}
    >
      {daysLabel}
    </span>

    {
      keepId && (
        <button
          type="button"
          data-keep-toggle
          data-item-id={keepId}
          data-active={String(!!keepActive)}
          class:list={[
            'keep-btn absolute top-2 left-2 z-10 rounded-full bg-black/60 p-1.5 text-white/70 opacity-0 transition-opacity group-hover:opacity-100 hover:text-white',
            keepActive && 'keep-active',
          ]}
          title={keepActive ? 'Keep requested — click to withdraw' : 'Request to keep'}
          aria-pressed={keepActive ? 'true' : 'false'}
          aria-label="Request to keep this item"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-4 w-4"
          >
            <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
          </svg>
        </button>
      )
    }
  </div>

  <div class="p-2">
    <p class="truncate text-xs font-medium leading-snug">{title}</p>
    {
      isGroup && (
        <p class="mt-0.5 text-[10px] text-white/35">
          {seasons!.length === 1
            ? `Season ${seasons![0].IndexNumber ?? ''} leaving`
            : `${seasons!.length} seasons leaving`}
        </p>
      )
    }
    {
      !isGroup && item.ProductionYear && (
        <p class="mt-0.5 text-[10px] text-white/40">{item.ProductionYear}</p>
      )
    }
  </div>
</a>

<style>
  .keep-btn.keep-active {
    color: var(--color-accent);
    opacity: 1;
  }
</style>

<script>
  // The card is one big <a>; stop the toggle from navigating. Delegated so a
  // single listener covers every card, and state is mirrored across duplicate
  // buttons for the same item (a series can appear in more than one shelf).
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-keep-toggle]');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    if (btn.dataset.busy) return;
    btn.dataset.busy = '1';

    const id = btn.dataset.itemId!;
    const active = btn.dataset.active === 'true';
    try {
      // Bodyless requests without a content-type hit Astro's strict CSRF
      // origin check, which fails behind a TLS-terminating proxy; a JSON
      // content-type routes it through the form-only check instead.
      const resp = await fetch(`/api/keep-requests/${id}`, {
        method: active ? 'DELETE' : 'PUT',
        headers: { 'Content-Type': 'application/json' },
      });
      if (resp.ok) {
        const next = !active;
        document
          .querySelectorAll<HTMLButtonElement>(`[data-keep-toggle][data-item-id="${id}"]`)
          .forEach((b) => {
            b.dataset.active = String(next);
            b.title = next ? 'Keep requested — click to withdraw' : 'Request to keep';
            b.setAttribute('aria-pressed', String(next));
            b.classList.toggle('keep-active', next);
          });
      }
    } finally {
      delete btn.dataset.busy;
    }
  });
</script>
