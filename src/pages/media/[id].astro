---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import {
  getMediaById,
  getLeavingSoonEntry,
  getKeepRequestItemIdsForUser,
  getNominationItemIdsForUser,
  getNominationCount,
  getLibraries,
  deleteSession,
} from '../../lib/db';
import {
  getItemDetail,
  getSeasonEpisodes,
  getSeriesSeasons,
  getCollectionItems,
  jellyfinWebUrl,
  daysFromTags,
  daysUntil,
  JellyfinSessionExpiredError,
} from '../../lib/jellyfin';
import {
  findRadarrMovieByTmdbId,
  isRadarrConfigured,
  resolveRadarrExternalUrl,
} from '../../lib/arr/radarr';
import {
  findSonarrSeriesByTvdbId,
  isSonarrConfigured,
  resolveSonarrExternalUrl,
} from '../../lib/arr/sonarr';
import { formatRuntime, leavingBadgeClass } from '../../lib/format';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const userToken = Astro.locals.jellyfinToken;
const localItem = getMediaById(id);
const localType = localItem?.itemType ?? null;

function expireSession() {
  const token = Astro.cookies.get('auth')?.value;
  if (token) deleteSession(token);
  Astro.cookies.delete('auth', { path: '/' });
  return Astro.redirect('/login');
}

// Fetch detail + sub-items in parallel where type is already known from the local DB.
// For proxy items (localType null) we do a second pass after resolving the type.
let jellyfinDetail: Awaited<ReturnType<typeof getItemDetail>>;
let preSeasons: Awaited<ReturnType<typeof getSeriesSeasons>>;
let preCollItems: Awaited<ReturnType<typeof getCollectionItems>>;
let preEpisodes: Awaited<ReturnType<typeof getSeasonEpisodes>>;
try {
  [jellyfinDetail, preSeasons, preCollItems, preEpisodes] = await Promise.all([
    getItemDetail(id, userToken),
    localType === 'Series' ? getSeriesSeasons(id, userToken) : Promise.resolve([]),
    localType === 'Collection' ? getCollectionItems(id, userToken) : Promise.resolve([]),
    localType === 'Season' ? getSeasonEpisodes(id, userToken) : Promise.resolve([]),
  ]);
} catch (e) {
  if (e instanceof JellyfinSessionExpiredError) return expireSession();
  throw e;
}

if (!localItem && !jellyfinDetail) {
  return new Response(null, { status: 404 });
}

const itemType =
  localItem?.itemType ??
  (jellyfinDetail?.Type === 'BoxSet' ? 'Collection' : (jellyfinDetail?.Type ?? null));

// Second-pass fetches for proxy items whose type is only known after getItemDetail resolves.
let seasons = preSeasons;
let collItems = preCollItems;
let episodes = preEpisodes;
if (!localType) {
  try {
    if (itemType === 'Series') seasons = await getSeriesSeasons(id, userToken);
    else if (itemType === 'Collection') collItems = await getCollectionItems(id, userToken);
    else if (itemType === 'Season') episodes = await getSeasonEpisodes(id, userToken);
  } catch (e) {
    if (e instanceof JellyfinSessionExpiredError) return expireSession();
    throw e;
  }
}

const name = localItem?.name ?? jellyfinDetail?.Name ?? '';
const year = localItem?.year ?? jellyfinDetail?.ProductionYear ?? null;
const overview = localItem?.overview ?? jellyfinDetail?.Overview ?? null;
const tagline = localItem?.tagline ?? jellyfinDetail?.Taglines?.[0] ?? null;
const posterTag = localItem?.posterTag ?? jellyfinDetail?.ImageTags?.Primary ?? null;
const backdropTag = localItem?.backdropTag ?? jellyfinDetail?.BackdropImageTags?.[0] ?? null;
const thumbTag = jellyfinDetail?.ImageTags?.Thumb ?? null;
const logoTag = jellyfinDetail?.ImageTags?.Logo ?? null;
const communityRating = localItem?.communityRating ?? jellyfinDetail?.CommunityRating ?? null;
const officialRating = localItem?.officialRating ?? jellyfinDetail?.OfficialRating ?? null;
const genres = localItem?.genres ?? jellyfinDetail?.Genres ?? null;
const runtimeTicks = localItem?.runtimeTicks ?? jellyfinDetail?.RunTimeTicks ?? null;
const providerIds = localItem?.providerIds ?? jellyfinDetail?.ProviderIds ?? null;
const seriesStatus = localItem?.seriesStatus ?? jellyfinDetail?.Status ?? null;
const episodeCount = localItem?.episodeCount ?? jellyfinDetail?.EpisodeCount ?? null;

// For Season items, build a richer nomination name so it's meaningful in the admin panel
const seriesName = localItem?.seriesName ?? jellyfinDetail?.SeriesName ?? null;
const indexNumber = localItem?.indexNumber ?? jellyfinDetail?.IndexNumber ?? null;
const nominationName =
  itemType === 'Season' && seriesName ? `${seriesName} : Season ${indexNumber ?? '?'}` : name;

// Seasons aren't stored in the local DB until they're tagged, so fall back to the parent
// Series' library slug (the Series item is always synced for a Series library).
const nominationLibrarySlug =
  localItem?.librarySlug ??
  (itemType === 'Season' && jellyfinDetail?.SeriesId
    ? (getMediaById(jellyfinDetail.SeriesId)?.librarySlug ?? '')
    : '');

// Leaving-soon countdown for the main item
const isLeavingSoon =
  localItem?.leavingSoon ?? (jellyfinDetail?.Tags ?? []).includes('leaving-soon');
let leavingDaysLeft: number | null = null;
if (isLeavingSoon) {
  const entry = getLeavingSoonEntry(id);
  if (entry?.expiresOn) {
    leavingDaysLeft = daysUntil(entry.expiresOn);
  } else if (jellyfinDetail?.Tags?.length) {
    leavingDaysLeft = daysFromTags(jellyfinDetail.Tags);
  } else if (localItem?.leavingDays != null) {
    leavingDaysLeft = localItem.leavingDays;
  }
}

// Leaving-soon countdown per season (for Series pages)
const seasonLeavingDays = new Map<string, number>();
for (const season of seasons) {
  const entry = getLeavingSoonEntry(season.Id);
  if (entry?.expiresOn) seasonLeavingDays.set(season.Id, daysUntil(entry.expiresOn));
}

// Per-user button state — only computed when a user is logged in
const userId = Astro.locals.user?.jellyfinId ?? null;
const keepActive =
  userId && leavingDaysLeft != null ? getKeepRequestItemIdsForUser(userId).has(id) : false;
const nominationLibrary = getLibraries().find((l) => l.slug === nominationLibrarySlug);
const canNominate =
  itemType !== 'Collection' &&
  leavingDaysLeft == null &&
  (nominationLibrary?.viewLeavingSoon ?? true);
const nominateActive = userId && canNominate ? getNominationItemIdsForUser(userId).has(id) : false;
const nominationCount = canNominate ? getNominationCount(id) : 0;

// Admin-only arr deep links — non-blocking, null if arr not configured or item not found
const isAdmin = Astro.locals.user?.isAdministrator ?? false;
let arrLink: string | null = null;
let arrLabel: string | null = null;
if (isAdmin) {
  if (itemType === 'Movie' && isRadarrConfigured()) {
    const tmdbId = providerIds?.Tmdb ?? providerIds?.TMDB;
    if (tmdbId) {
      const movie = await findRadarrMovieByTmdbId(tmdbId).catch(() => null);
      if (movie?.titleSlug) {
        arrLink = `${resolveRadarrExternalUrl()}/movie/${movie.titleSlug}`;
        arrLabel = 'Radarr';
      }
    }
  } else if ((itemType === 'Series' || itemType === 'Season') && isSonarrConfigured()) {
    let tvdbId = providerIds?.Tvdb ?? providerIds?.TVDB;
    if (!tvdbId && itemType === 'Season') {
      const seriesId = localItem?.seriesId ?? jellyfinDetail?.SeriesId;
      if (seriesId) tvdbId = getMediaById(seriesId)?.providerIds?.Tvdb;
    }
    if (tvdbId) {
      const series = await findSonarrSeriesByTvdbId(tvdbId).catch(() => null);
      if (series?.titleSlug) {
        arrLink = `${resolveSonarrExternalUrl()}/series/${series.titleSlug}`;
        arrLabel = 'Sonarr';
      }
    }
  }
}

const backHref = localItem?.librarySlug
  ? `/library/${localItem.librarySlug}`
  : itemType === 'Season' && jellyfinDetail?.SeriesId
    ? `/media/${jellyfinDetail.SeriesId}`
    : '/';

const runtime = runtimeTicks ? formatRuntime(runtimeTicks) : null;
const watchUrl = jellyfinWebUrl(id);
const imdbId = providerIds?.Imdb ?? providerIds?.IMDB ?? null;

const posterSrc = posterTag
  ? `/api/image/Primary/${id}?tag=${encodeURIComponent(posterTag)}&w=500`
  : null;

// Prefer wide 16:9 images for the backdrop; fall back to thumb, then parent series (for seasons), then skip
const parentBackdropTag = jellyfinDetail?.ParentBackdropImageTags?.[0] ?? null;
const parentBackdropId = jellyfinDetail?.ParentBackdropItemId ?? null;
const parentLogoTag = jellyfinDetail?.ParentLogoImageTag ?? null;
const parentLogoId = jellyfinDetail?.ParentLogoItemId ?? null;

const backdropSrc = backdropTag
  ? `/api/image/Backdrop/${id}?tag=${encodeURIComponent(backdropTag)}&w=1920`
  : thumbTag
    ? `/api/image/Thumb/${id}?tag=${encodeURIComponent(thumbTag)}&w=1920`
    : parentBackdropTag && parentBackdropId
      ? `/api/image/Backdrop/${parentBackdropId}?tag=${encodeURIComponent(parentBackdropTag)}&w=1920`
      : null;

const logoSrc = logoTag
  ? `/api/image/Logo/${id}?tag=${encodeURIComponent(logoTag)}&w=600`
  : parentLogoTag && parentLogoId
    ? `/api/image/Logo/${parentLogoId}?tag=${encodeURIComponent(parentLogoTag)}&w=600`
    : null;

const cast = jellyfinDetail?.People?.filter((p) => p.Type === 'Actor').slice(0, 14) ?? [];
const directors = jellyfinDetail?.People?.filter((p) => p.Type === 'Director') ?? [];
const studios = jellyfinDetail?.Studios ?? [];

const textMeta: string[] = [];
if (year) textMeta.push(String(year));
if (itemType === 'Series') {
  textMeta.push('TV Series');
  if (episodeCount) textMeta.push(`${episodeCount} episodes`);
  if (seriesStatus) textMeta.push(seriesStatus);
} else if (itemType === 'Season') {
  if (jellyfinDetail?.IndexNumber != null) textMeta.push(`Season ${jellyfinDetail.IndexNumber}`);
  if (jellyfinDetail?.SeriesName) textMeta.push(jellyfinDetail.SeriesName);
  if (episodes.length > 0) textMeta.push(`${episodes.length} episodes`);
} else if (itemType === 'Collection') {
  textMeta.push('Collection');
}
if (runtime) textMeta.push(runtime);
---

<Layout title={`${name} — Tideline`}>
  <!-- ── Backdrop hero ──────────────────────────────────────────── -->
  <div class="-mx-6 -mt-10 relative h-[55vh] min-h-72 max-h-140 overflow-hidden">
    {
      backdropSrc ? (
        <Image
          src={backdropSrc}
          width={1920}
          height={1080}
          alt=""
          class="absolute inset-0 h-full w-full object-cover object-center"
          aria-hidden="true"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="absolute inset-0 bg-linear-to-br from-white/5 to-transparent" />
      )
    }

    <!-- Gradient overlays -->
    <div class="absolute inset-0 bg-linear-to-t from-[#0d0d1a] via-[#0d0d1a]/30 to-transparent">
    </div>
    <div class="absolute inset-0 bg-linear-to-t from-[#0d0d1a]/80 via-[#0d0d1a]/20 to-transparent">
    </div>

    <!-- Back button -->
    <div class="absolute top-5 left-5">
      <a
        href={backHref}
        class="inline-flex items-center gap-1.5 rounded-lg bg-black/50 px-3 py-2 text-sm text-white/80 backdrop-blur-sm transition-colors hover:bg-black/70 hover:text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-4 w-4 shrink-0"
        >
          <path
            fill-rule="evenodd"
            d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"
            clip-rule="evenodd"></path>
        </svg>
        Back
      </a>
    </div>

    <!-- Logo overlay — positioned above the content pull-up zone -->
    {
      logoSrc && (
        <div class="absolute bottom-56 left-6 sm:bottom-64 sm:left-8">
          <Image
            src={logoSrc}
            width={600}
            height={200}
            alt={name}
            loading="eager"
            class="max-h-24 max-w-70 sm:max-h-36 sm:max-w-sm object-contain drop-shadow-2xl"
          />
        </div>
      )
    }
  </div>

  <!-- ── Main content ───────────────────────────────────────────── -->
  <div class="-mt-48 sm:-mt-56 relative z-10 max-w-5xl mx-auto px-1">
    <!-- Poster + title block -->
    <div class="flex gap-6 sm:gap-8 items-end">
      <!-- Poster -->
      {
        posterSrc && (
          <div class="hidden sm:block shrink-0 w-44 lg:w-56 rounded-xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.8)] ring-1 ring-white/10">
            <Image
              src={posterSrc}
              width={500}
              height={750}
              alt={name}
              class="w-full"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }

      <!-- Title & meta -->
      <div class="flex-1 min-w-0 pb-1">
        {
          !logoSrc && (
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight drop-shadow-lg">
              {name}
            </h1>
          )
        }
        {logoSrc && <h1 class="sr-only">{name}</h1>}

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          {
            textMeta.length > 0 && (
              <span class="font-medium text-white/70">{textMeta.join(' · ')}</span>
            )
          }
          {
            officialRating && (
              <span class="rounded border border-white/25 px-2 py-0.5 text-xs font-semibold tracking-wide text-white/70">
                {officialRating}
              </span>
            )
          }
          {
            communityRating && (
              <span class="flex items-center gap-1.5 text-amber-400">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-4 w-4"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span class="font-bold">{communityRating.toFixed(1)}</span>
              </span>
            )
          }
          {
            leavingDaysLeft != null && (
              <span
                class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ${leavingBadgeClass(leavingDaysLeft)}`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-3 w-3 shrink-0"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z"
                    clip-rule="evenodd"
                  />
                </svg>
                {leavingDaysLeft === 1 ? '1 day left' : `${leavingDaysLeft} days left`}
              </span>
            )
          }
        </div>

        {
          tagline && (
            <p class="mt-3 text-sm sm:text-base italic text-white/45 leading-snug">{tagline}</p>
          )
        }

        {
          genres && genres.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {genres.map((g) => (
                <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/70 ring-1 ring-white/10">
                  {g}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <!-- Action buttons -->
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={watchUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-accent/20 transition-colors hover:bg-accent-hover"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-4 w-4"
        >
          <path
            d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z"
          ></path>
        </svg>
        Watch in Jellyfin
      </a>
      {
        imdbId && (
          <a
            href={`https://www.imdb.com/title/${imdbId}/`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-5 py-2.5 text-sm font-medium text-white/70 transition-colors hover:border-white/30 hover:text-white"
          >
            IMDb
          </a>
        )
      }
      {
        arrLink && arrLabel && (
          <a
            href={arrLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-5 py-2.5 text-sm font-medium text-white/70 transition-colors hover:border-white/30 hover:text-white"
          >
            {arrLabel}
          </a>
        )
      }
      {
        userId && leavingDaysLeft != null && (
          <button
            type="button"
            data-keep-toggle
            data-item-id={id}
            data-active={String(keepActive)}
            class:list={[
              'keep-btn inline-flex items-center gap-2 rounded-lg border border-white/15 px-5 py-2.5 text-sm font-medium text-white/70 transition-colors hover:border-white/30 hover:text-white',
              keepActive && 'keep-active',
            ]}
            title={keepActive ? 'Keep requested — click to withdraw' : 'Request to keep'}
            aria-pressed={keepActive ? 'true' : 'false'}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-4 w-4"
            >
              <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
            </svg>
            {keepActive ? 'Keep Requested' : 'Request Keep'}
          </button>
        )
      }
      {
        userId && canNominate && (
          <div class="flex flex-col items-start gap-1">
            <button
              type="button"
              data-nominate-toggle
              data-item-id={id}
              data-item-name={nominationName}
              data-library-slug={nominationLibrarySlug}
              data-active={String(nominateActive)}
              class:list={[
                'nominate-btn inline-flex items-center gap-2 rounded-lg border border-white/15 px-5 py-2.5 text-sm font-medium text-white/70 transition-colors hover:border-white/30 hover:text-white',
                nominateActive && 'nominate-active',
              ]}
              title={
                nominateActive ? 'Withdraw nomination' : 'Suggest this item should be leaving soon'
              }
              aria-pressed={nominateActive ? 'true' : 'false'}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-4 w-4"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z"
                  clip-rule="evenodd"
                />
              </svg>
              {nominateActive ? 'Nominated' : 'Suggest leaving soon'}
            </button>
            {nominationCount > 0 && (
              <p class="nominate-count pl-1 text-[11px] text-white/30">
                {nominationCount} {nominationCount === 1 ? 'user' : 'users'} suggested
              </p>
            )}
          </div>
        )
      }
    </div>

    <!-- Overview -->
    {
      overview && (
        <div class="mt-12">
          <h2 class="mb-3 text-xs font-semibold uppercase tracking-widest text-white/30">
            Overview
          </h2>
          <p class="max-w-3xl text-[15px] leading-7 text-white/75">{overview}</p>
        </div>
      )
    }

    <!-- Director + Studio row -->
    {
      (directors.length > 0 || studios.length > 0) && (
        <div class="mt-10 flex flex-wrap gap-10">
          {directors.length > 0 && (
            <div>
              <p class="mb-1.5 text-xs font-semibold uppercase tracking-widest text-white/30">
                {directors.length === 1 ? 'Director' : 'Directors'}
              </p>
              <p class="text-sm font-medium text-white/80">
                {directors.map((d) => d.Name).join(', ')}
              </p>
            </div>
          )}
          {studios.length > 0 && (
            <div>
              <p class="mb-1.5 text-xs font-semibold uppercase tracking-widest text-white/30">
                Studio
              </p>
              <p class="text-sm font-medium text-white/80">
                {studios.map((s) => s.Name).join(', ')}
              </p>
            </div>
          )}
        </div>
      )
    }

    <!-- Cast -->
    {
      cast.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-5 text-xs font-semibold uppercase tracking-widest text-white/30">Cast</h2>
          <div class="-mx-1 flex gap-5 overflow-x-auto px-1 pb-4">
            {cast.map((person) => (
              <div class="w-24 shrink-0 text-center">
                <div class="mx-auto h-20 w-20 overflow-hidden rounded-full bg-white/10 ring-2 ring-white/5">
                  {person.PrimaryImageTag ? (
                    <Image
                      src={`/api/image/Primary/${person.Id}?tag=${encodeURIComponent(person.PrimaryImageTag)}&w=200`}
                      width={200}
                      height={200}
                      alt={person.Name}
                      class="h-full w-full object-cover object-[center_15%]"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center text-white/20">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="h-8 w-8"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </div>
                  )}
                </div>
                <p class="mt-2.5 text-xs font-semibold leading-tight text-white/85">
                  {person.Name}
                </p>
                {person.Role && (
                  <p class="mt-0.5 line-clamp-2 text-[11px] leading-tight text-white/40">
                    {person.Role}
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- Seasons (Series) -->
    {
      seasons.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-5 text-xs font-semibold uppercase tracking-widest text-white/30">
            Seasons
          </h2>
          <div class="flex flex-col gap-2">
            {seasons.map((season) => {
              const seasonLabel =
                season.IndexNumber != null ? `Season ${season.IndexNumber}` : season.Name;
              const thumbSrc = season.ImageTags?.Primary
                ? `/api/image/Primary/${season.Id}?tag=${encodeURIComponent(season.ImageTags.Primary)}&w=300`
                : null;
              const epCount = season.ChildCount ?? season.EpisodeCount ?? null;
              const seasonDays = seasonLeavingDays.get(season.Id) ?? null;
              return (
                <a
                  href={`/media/${season.Id}`}
                  class="group flex items-center gap-4 rounded-xl bg-white/5 p-3 ring-1 ring-white/5 transition-colors hover:bg-white/10 hover:ring-white/15"
                >
                  <div class="relative h-20 w-14 shrink-0 overflow-hidden rounded-lg bg-white/10">
                    {thumbSrc ? (
                      <Image
                        src={thumbSrc}
                        width={200}
                        height={300}
                        alt={seasonLabel}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center text-white/20">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="h-6 w-6"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M1.5 5.625c0-1.036.84-1.875 1.875-1.875h17.25c1.035 0 1.875.84 1.875 1.875v12.75c0 1.035-.84 1.875-1.875 1.875H3.375A1.875 1.875 0 0 1 1.5 18.375V5.625Zm1.5 0v1.5c0 .207.168.375.375.375h1.5a.375.375 0 0 0 .375-.375v-1.5a.375.375 0 0 0-.375-.375h-1.5A.375.375 0 0 0 3 5.625Zm16.125-.375a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5A.375.375 0 0 0 21 7.125v-1.5a.375.375 0 0 0-.375-.375h-1.5ZM21 9.375A.375.375 0 0 0 20.625 9h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5a.375.375 0 0 0 .375-.375v-1.5Zm0 3.75a.375.375 0 0 0-.375-.375h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5a.375.375 0 0 0 .375-.375v-1.5Zm0 3.75a.375.375 0 0 0-.375-.375h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5a.375.375 0 0 0 .375-.375v-1.5ZM4.875 18.75a.375.375 0 0 0 .375-.375v-1.5a.375.375 0 0 0-.375-.375h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5ZM3.375 15h1.5a.375.375 0 0 0 .375-.375v-1.5a.375.375 0 0 0-.375-.375h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375Zm0-3.75h1.5a.375.375 0 0 0 .375-.375v-1.5A.375.375 0 0 0 4.875 9h-1.5A.375.375 0 0 0 3 9.375v1.5c0 .207.168.375.375.375Zm4.125 0a.75.75 0 0 0 0 1.5h9a.75.75 0 0 0 0-1.5h-9Zm-.375 4.125c0-.414.336-.75.75-.75h9a.75.75 0 0 1 0 1.5h-9a.75.75 0 0 1-.75-.75ZM7.5 6.75a.75.75 0 0 0 0 1.5h9a.75.75 0 0 0 0-1.5h-9Z"
                            clip-rule="evenodd"
                          />
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="font-medium text-white/90 group-hover:text-white">{seasonLabel}</p>
                    <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-white/40">
                      {season.ProductionYear && <span>{season.ProductionYear}</span>}
                      {epCount != null && (
                        <span>
                          {epCount} {epCount === 1 ? 'episode' : 'episodes'}
                        </span>
                      )}
                      {seasonDays != null && (
                        <span
                          class={`rounded-full px-2 py-0.5 font-semibold ${leavingBadgeClass(seasonDays)}`}
                        >
                          {seasonDays === 1 ? '1 day left' : `${seasonDays} days left`}
                        </span>
                      )}
                    </div>
                    {season.Overview && (
                      <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-white/40">
                        {season.Overview}
                      </p>
                    )}
                  </div>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-5 w-5 shrink-0 text-white/20 group-hover:text-white/40"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              );
            })}
          </div>
        </div>
      )
    }

    <!-- Collection items -->
    {
      collItems.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-5 text-xs font-semibold uppercase tracking-widest text-white/30">
            In this Collection
          </h2>
          <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-5">
            {collItems.map((movie) => {
              const moviePosterTag = movie.ImageTags?.Primary;
              const moviePosterSrc = moviePosterTag
                ? `/api/image/Primary/${movie.Id}?tag=${encodeURIComponent(moviePosterTag)}&w=300`
                : null;
              return (
                <a
                  href={`/media/${movie.Id}`}
                  class="group flex flex-col overflow-hidden rounded-lg ring-1 ring-white/5 transition-all hover:ring-white/20"
                >
                  <div class="relative aspect-2/3 w-full overflow-hidden bg-white/5">
                    {moviePosterSrc ? (
                      <Image
                        src={moviePosterSrc}
                        width={300}
                        height={450}
                        alt={movie.Name}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full items-center justify-center text-white/20">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="h-8 w-8"
                        >
                          <path d="M12 9a3.75 3.75 0 1 0 0 7.5A3.75 3.75 0 0 0 12 9Z" />
                          <path
                            fill-rule="evenodd"
                            d="M9.344 3.071a49.52 49.52 0 0 1 5.312 0c.967.052 1.83.585 2.332 1.39l.821 1.317c.24.383.645.643 1.11.71.386.054.77.113 1.152.177 1.432.239 2.429 1.493 2.429 2.909V18a3 3 0 0 1-3 3h-15a3 3 0 0 1-3-3V9.574c0-1.416.997-2.67 2.429-2.909.382-.064.766-.123 1.151-.178a1.56 1.56 0 0 0 1.11-.71l.822-1.315a2.942 2.942 0 0 1 2.332-1.39ZM6.75 12.75a5.25 5.25 0 1 1 10.5 0 5.25 5.25 0 0 1-10.5 0Zm12-1.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z"
                            clip-rule="evenodd"
                          />
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="p-2">
                    <p class="line-clamp-2 text-xs font-medium leading-snug text-white/80 group-hover:text-white">
                      {movie.Name}
                    </p>
                    {movie.ProductionYear && (
                      <p class="mt-0.5 text-[10px] text-white/35">{movie.ProductionYear}</p>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )
    }

    <!-- Episodes (Season) -->
    {
      episodes.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-5 text-xs font-semibold uppercase tracking-widest text-white/30">
            Episodes
          </h2>
          <div class="flex flex-col divide-y divide-white/5">
            {episodes.map((ep) => {
              const epStill = ep.ImageTags?.Primary
                ? `/api/image/Primary/${ep.Id}?tag=${encodeURIComponent(ep.ImageTags.Primary)}&w=320`
                : null;
              return (
                <div class="py-4 first:pt-0">
                  <div class="flex items-start gap-3 sm:gap-4">
                    <span class="w-7 shrink-0 pt-1 text-right text-xs font-mono text-white/25">
                      {ep.IndexNumber ?? ''}
                    </span>
                    {/* 16:9 still — hidden on mobile to save space */}
                    <div class="relative hidden aspect-video w-40 shrink-0 overflow-hidden rounded-md bg-white/5 sm:block">
                      {epStill ? (
                        <Image
                          src={epStill}
                          width={320}
                          height={180}
                          alt={ep.Name}
                          class="h-full w-full object-cover"
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex h-full items-center justify-center text-white/15">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="h-6 w-6"
                          >
                            <path
                              fill-rule="evenodd"
                              d="M1.5 5.625c0-1.036.84-1.875 1.875-1.875h17.25c1.035 0 1.875.84 1.875 1.875v12.75c0 1.035-.84 1.875-1.875 1.875H3.375A1.875 1.875 0 0 1 1.5 18.375V5.625Zm1.5 0v1.5c0 .207.168.375.375.375h1.5a.375.375 0 0 0 .375-.375v-1.5a.375.375 0 0 0-.375-.375h-1.5A.375.375 0 0 0 3 5.625Zm16.125-.375a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5A.375.375 0 0 0 21 7.125v-1.5a.375.375 0 0 0-.375-.375h-1.5ZM21 9.375A.375.375 0 0 0 20.625 9h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5a.375.375 0 0 0 .375-.375v-1.5Zm0 3.75a.375.75 0 0 0-.375-.375h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5a.375.375 0 0 0 .375-.375v-1.5Zm0 3.75a.375.375 0 0 0-.375-.375h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5a.375.375 0 0 0 .375-.375v-1.5ZM4.875 18.75a.375.375 0 0 0 .375-.375v-1.5a.375.375 0 0 0-.375-.375h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375h1.5ZM3.375 15h1.5a.375.375 0 0 0 .375-.375v-1.5a.375.375 0 0 0-.375-.375h-1.5a.375.375 0 0 0-.375.375v1.5c0 .207.168.375.375.375Zm0-3.75h1.5a.375.375 0 0 0 .375-.375v-1.5A.375.375 0 0 0 4.875 9h-1.5A.375.375 0 0 0 3 9.375v1.5c0 .207.168.375.375.375Zm4.125 0a.75.75 0 0 0 0 1.5h9a.75.75 0 0 0 0-1.5h-9Zm-.375 4.125c0-.414.336-.75.75-.75h9a.75.75 0 0 1 0 1.5h-9a.75.75 0 0 1-.75-.75ZM7.5 6.75a.75.75 0 0 0 0 1.5h9a.75.75 0 0 0 0-1.5h-9Z"
                              clip-rule="evenodd"
                            />
                          </svg>
                        </div>
                      )}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-start justify-between gap-4">
                        <p class="font-medium text-white/90">{ep.Name}</p>
                        {ep.RunTimeTicks && (
                          <span class="shrink-0 text-xs text-white/35">
                            {formatRuntime(ep.RunTimeTicks)}
                          </span>
                        )}
                      </div>
                      {ep.Overview && (
                        <p class="mt-1.5 line-clamp-3 text-sm leading-relaxed text-white/45">
                          {ep.Overview}
                        </p>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )
    }
  </div>

  <!-- Bottom spacer -->
  <div class="h-12"></div>
</Layout>

<style>
  .keep-btn.keep-active {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .nominate-btn.nominate-active {
    color: rgb(251 191 36);
    border-color: rgb(251 191 36 / 0.5);
  }
</style>

<script>
  function setKeepState(btn: HTMLButtonElement, active: boolean) {
    btn.dataset.active = String(active);
    btn.setAttribute('aria-pressed', String(active));
    btn.classList.toggle('keep-active', active);
    btn.title = active ? 'Keep requested — click to withdraw' : 'Request to keep';
    const last = btn.lastChild as Text | null;
    if (last?.nodeType === Node.TEXT_NODE)
      last.textContent = active ? ' Keep Requested' : ' Request Keep';
  }

  function setNominateState(btn: HTMLButtonElement, active: boolean, delta = 0) {
    btn.dataset.active = String(active);
    btn.setAttribute('aria-pressed', String(active));
    btn.classList.toggle('nominate-active', active);
    btn.title = active ? 'Withdraw nomination' : 'Suggest this item should be leaving soon';
    const label = btn.querySelector('svg ~ *') as HTMLElement | null;
    if (label) label.textContent = active ? 'Nominated' : 'Suggest leaving soon';
    if (delta !== 0) {
      const countEl = btn.closest('div')?.querySelector<HTMLElement>('.nominate-count');
      if (countEl) {
        const current = parseInt(countEl.dataset.count ?? '0', 10) || 0;
        const updated = Math.max(0, current + delta);
        countEl.dataset.count = String(updated);
        countEl.textContent =
          updated > 0 ? `${updated} ${updated === 1 ? 'user' : 'users'} suggested` : '';
      }
    }
  }

  // Keep request toggle — also clears any active nomination
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-keep-toggle]');
    if (!btn || btn.dataset.busy) return;
    btn.dataset.busy = '1';
    const id = btn.dataset.itemId!;
    const active = btn.dataset.active === 'true';
    try {
      const resp = await fetch(`/api/keep-requests/${id}`, {
        method: active ? 'DELETE' : 'PUT',
        headers: { 'Content-Type': 'application/json' },
      });
      if (resp.ok) {
        const next = !active;
        setKeepState(btn, next);
        // Server removes the nomination when a keep is added — mirror that in the UI
        if (next) {
          const nomBtn = document.querySelector<HTMLButtonElement>('[data-nominate-toggle]');
          if (nomBtn?.dataset.active === 'true') setNominateState(nomBtn, false, -1);
        }
      }
    } finally {
      delete btn.dataset.busy;
    }
  });

  // Nominate toggle — also clears any active keep request
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-nominate-toggle]');
    if (!btn || btn.dataset.busy) return;
    btn.dataset.busy = '1';
    const id = btn.dataset.itemId!;
    const active = btn.dataset.active === 'true';
    try {
      const resp = await fetch(`/api/nominations/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: active
          ? JSON.stringify({})
          : JSON.stringify({
              itemName: btn.dataset.itemName,
              librarySlug: btn.dataset.librarySlug || null,
            }),
      });
      if (resp.ok) {
        const next = !active;
        setNominateState(btn, next, next ? 1 : -1);
        // Server removes the keep request when a nomination is added — mirror that in the UI
        if (next) {
          const keepBtn = document.querySelector<HTMLButtonElement>('[data-keep-toggle]');
          if (keepBtn?.dataset.active === 'true') setKeepState(keepBtn, false);
        }
      }
    } finally {
      delete btn.dataset.busy;
    }
  });
</script>
