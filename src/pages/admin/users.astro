---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import UserManager from '../../components/admin/UserManager.svelte';
import { getUsersWithSessionCounts } from '../../lib/db';

const users = getUsersWithSessionCounts();
---

<Layout title="Admin — Users — Tideline">
  <div class="max-w-4xl mx-auto space-y-8">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Admin</h1>
    </div>

    <AdminNav />

    <section>
      <h2 class="mb-1 text-lg font-semibold">Users</h2>
      <p class="mb-5 text-sm text-white/40">
        Accounts that have signed in. Evicting sessions signs that user out everywhere immediately.
      </p>
      <UserManager users={users} client:load />
    </section>
  </div>
</Layout>
